# Single .gitignore for the whole repo (webapp + every backend service).
# Don't add per-project .gitignore files; patterns here apply at any depth unless they start with a project path.

# ─── OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors / IDEs ───────────────────────────────
.idea/
*.iml
*.iws
*.ipr
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
# Eclipse / STS (also used by the VS Code Java extension)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
*.swp
*.sw?
*.suo
*.sln
*.ntvs*
*.njsproj

# ─── Secrets & env (commit only *.example files) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore

# ─── Logs ─────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Node / frontend (webapp, packages, mobile) ───
node_modules/
dist/
dist-ssr/
coverage/
*.local
*.tsbuildinfo
.eslintcache
.vite/
# Playwright
test-results/
playwright-report/
blob-report/
**/playwright/.cache/
# Expo / React Native (mobile/)
.expo/
web-build/

# ─── Java / Gradle (backend services) ─────────────
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
# IDE compiler output (VS Code Java / Eclipse: bin/, IntelliJ: out/)
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
out/
!**/src/main/**/out/
!**/src/test/**/out/
!**/gradle/wrapper/gradle-wrapper.jar
# Spring Initializr notes
HELP.md
*.class
hs_err_pid*
replay_pid*
# Spring Boot local overrides
application-local-*.properties

# ─── Infrastructure ───────────────────────────────
# Docker volumes mounted into the repo for local data
infrastructure/docker/data/
infrastructure/docker/volumes/
# Kubernetes secrets
infrastructure/k8s/**/secret*.yaml
infrastructure/k8s/**/secret*.yml

# ─── Claude Code (keep skills/commands/prompts, ignore personal state) ─
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
CLAUDE.local.md
